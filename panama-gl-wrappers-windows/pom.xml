<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jzy3d</groupId>
		<artifactId>panama-gl</artifactId>
		<version>1.4.1</version>
	</parent>

	<artifactId>panama-gl-wrappers-windows</artifactId>
	<name>Panama GL Wrappers - Windows</name>

	<dependencies>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-api</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-bindings-windows</artifactId>
			<version>${panamagl.bindings.version}</version>
		</dependency>

		<!-- Function pointer classes (PFN...PROC) invoking the functions resolved at runtime, and the
		     OpenGL constants, on all OS -->
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-bindings-glext</artifactId>
			<version>${panamagl.bindings.version}</version>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<executions>
					<!-- All the tests, with the optional freeglut jar in the classpath on Windows -->
					<execution>
						<id>default-test</id>
						<configuration>
							<excludes>
								<exclude>**/TestGLUT_windows_withoutFreeglut.java</exclude>
							</excludes>
						</configuration>
					</execution>
					<!-- What happens when freeglut is missing : the optional freeglut jar is excluded
					     from the classpath, and freeglut is not installed on CI -->
					<execution>
						<id>without-freeglut</id>
						<goals>
							<goal>test</goal>
						</goals>
						<configuration>
							<includes combine.self="override">
								<include>**/TestGLUT_windows_withoutFreeglut.java</include>
							</includes>
							<classpathDependencyExcludes>
								<classpathDependencyExclude>org.jzy3d:panama-gl-bindings-windows-freeglut</classpathDependencyExclude>
							</classpathDependencyExcludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
