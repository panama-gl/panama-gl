<project xmlns="https://maven.apache.org/POM/4.0.0" xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://maven.apache.org/POM/4.0.0 ">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.jzy3d</groupId>
		<artifactId>panama-gl</artifactId>
		<version>1.4.1</version>
	</parent>

	<artifactId>panama-gl-samples</artifactId>
	<name>Panama GL Samples</name>

	<dependencies>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-api</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-wrappers-all</artifactId>
			<version>${project.version}</version>
			<type>pom</type>
		</dependency>

		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-ui-awt</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-ui-swing</artifactId>
			<version>${project.version}</version>
		</dependency>

		<!-- AS FOR SWT, MIXING AWT AND JAVAFX IN THE CLASSPATH LEAD TO HANGS OF SWING DEMOS ON MACOS -->
		<!--<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-ui-swt</artifactId>
			<version>${project.version}</version>
		</dependency>-->

		<!--<dependency>
			<groupId>org.jzy3d</groupId>
			<artifactId>panama-gl-ui-javafx</artifactId>
			<version>${project.version}</version>
		</dependency>-->
	</dependencies>

	<profiles>
		<!-- The teapot demos use GLUT, which Windows does not provide : freeglut.dll for x86_64 and
		     ARM64, used if no freeglut.dll is in the java.library.path -->
		<profile>
			<id>Windows</id>
			<activation>
				<os>
					<family>Windows</family>
				</os>
			</activation>
			<dependencies>
				<dependency>
					<groupId>org.jzy3d</groupId>
					<artifactId>panama-gl-bindings-windows-freeglut</artifactId>
					<version>${panamagl.bindings.version}</version>
					<scope>runtime</scope>
				</dependency>
			</dependencies>
		</profile>
	</profiles>
</project>
